# Application
NODE_ENV=development

# Frontend
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=http://localhost:3000/ws

# Backend
API_PORT=3000

# PostgreSQL
POSTGRES_DB=hau_cex
POSTGRES_USER=hau
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://hau:change-me@localhost:5432/hau_cex

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Streams
ENGINE_COMMAND_STREAM=stream:engine:commands
ENGINE_EVENT_STREAM=stream:engine:events
MARKET_EVENT_STREAM=stream:market:events
DEAD_LETTER_STREAM=stream:dead-letter