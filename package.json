{
  "name": "hau-cex",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:web": "pnpm --filter @hau-cex/web dev",
    "build:web": "pnpm --filter @hau-cex/web build",
    "lint:web": "pnpm --filter @hau-cex/web lint",
    "dev:api": "pnpm --filter @hau-cex/backend start:api:dev",
    "dev:worker": "pnpm --filter @hau-cex/backend start:worker:dev",
    "build:backend": "pnpm --filter @hau-cex/backend build",
    "build:api": "pnpm --filter @hau-cex/backend build:api",
    "build:worker": "pnpm --filter @hau-cex/backend build:worker",
    "start:api": "pnpm --filter @hau-cex/backend start:api:prod",
    "start:worker": "pnpm --filter @hau-cex/backend start:worker:prod",
    "lint:backend": "pnpm --filter @hau-cex/backend lint",
    "format:backend": "pnpm --filter @hau-cex/backend format",
    "test:backend": "pnpm --filter @hau-cex/backend test",
    "test:e2e:backend": "pnpm --filter @hau-cex/backend test:e2e",
    "dev:engine": "cd services/matching-engine && go run ./cmd/engine/main.go",
    "test:engine": "cd services/matching-engine && go test ./...",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "contracts:compile": "pnpm --filter @hau-cex/contracts compile",
    "contracts:test": "pnpm --filter @hau-cex/contracts test",
    "contracts:node": "pnpm --filter @hau-cex/contracts node",
    "contracts:clean": "pnpm --filter @hau-cex/contracts run clean",
    "db:validate": "pnpm --filter @hau-cex/backend db:validate",
    "db:generate": "pnpm --filter @hau-cex/backend db:generate",
    "db:seed": "pnpm --filter @hau-cex/backend db:seed",
    "db:format": "pnpm --filter @hau-cex/backend db:format",
    "db:migrate": "pnpm --filter @hau-cex/backend db:migrate",
    "db:studio": "pnpm --filter @hau-cex/backend db:studio",
    "db:reset": "pnpm --filter @hau-cex/backend db:reset"
  },
  "packageManager": "pnpm@11.11.0+sha512.4463f65fd80ed80d69bc1d4bf163ee94f605c7380fc318bb5b2ebe15f8cd12d49c51a4d59e951b401e764d3b6ca751cbf51bc50ed7001a6bcb4935e684c34882"
}
