{
  "name": "hau-cex",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev:web": "pnpm -C apps/web hau-cex/web dev",
    "build:web": "pnpm -C apps/web hau-cex/web build",
    "lint:web": "pnpm -C apps/web hau-cex/web lint",
    "dev:api": "pnpm -C apps/backend hau-cex/backend start:api:dev",
    "dev:worker": "pnpm -C apps/backend hau-cex/backend start:worker:dev",
    "build:backend": "pnpm -C apps/backend hau-cex/backend build",
    "build:api": "pnpm -C apps/backend hau-cex/backend build:api",
    "build:worker": "pnpm -C apps/backend hau-cex/backend build:worker",
    "start:api": "pnpm -C apps/backend hau-cex/backend start:api:prod",
    "start:worker": "pnpm -C apps/backend hau-cex/backend start:worker:prod",
    "lint:backend": "pnpm -C apps/backend hau-cex/backend lint",
    "format:backend": "pnpm -C apps/backend hau-cex/backend format",
    "test:backend": "pnpm -C apps/backend hau-cex/backend test",
    "test:e2e:backend": "pnpm -C apps/backend hau-cex/backend test:e2e"
  }
}
