{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "main-api",
  "compilerOptions": {
    "deleteOutDir": true,
    "tsConfigPath": "tsconfig.api.json",
    "assets": [
      { "include": "generated/**/*", "watchAssets": true }
    ]
  }
}
