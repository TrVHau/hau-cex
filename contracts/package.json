{
  "name": "@hau-cex/contracts",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "hardhat compile",
    "compile": "hardhat compile",
    "test": "mocha",
    "node": "hardhat node",
    "clean": "hardhat clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "deploy:local": "hardhat --network hardhat run scripts/deploy.ts",
    "deploy:localhost": "hardhat --network localhost run scripts/deploy.ts",
    "deploy:sepolia": "hardhat --network sepolia run scripts/deploy.ts",
    "deploy:bscTestnet": "hardhat --network bscTestnet run scripts/deploy.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nomicfoundation/hardhat-ethers": "^4.0.15",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "chai": "^4.5.0",
    "eslint": "^10.12.0",
    "eslint-plugin-import": "^2.32.0",
    "ethers": "^6.17.0",
    "hardhat": "^3.9.1",
    "mocha": "^11.7.6",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.6.1"
  }
}
