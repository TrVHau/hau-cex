{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,

    "composite": true,
    "incremental": true,
    "noEmitOnError": true
  },

  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
